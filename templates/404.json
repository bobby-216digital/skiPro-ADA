{"sections":{"section_custom_code_hJiP3w":{"type":"section-custom-code","name":"Custom code","settings":{"code":"<div class=\"section__container\">\n<b style=\"text-align: center; padding-top: 1rem\">If I just keep going downhill, I'll find a trail eventually... right?<\/b>\n  <div class=\"image__container--404\">\n    <img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0568\/2020\/3697\/files\/404__Cliff-Drop.gif?v=1716496899\" alt=\"404\">\n  <\/div>\n  <div class=\"safety__container\">\n    <a href=\"\/\">\n      <div class=\"safety__button\">\n        <div class=\"button__square\">\n          <div class=\"button__circle\"><\/div>\n        <\/div>\n        <div class=\"button__text\">\n          <p>Easiest Way Down<\/p>\n        <\/div>\n      <\/div>\n    <\/a>\n  <\/div>\n<\/div>\n<style>\n  .section__container {\n    max-width: 800px;\n    display: flex;\n    align-items: center;\n    flex-direction: column;\n    justify-content: center;\n    margin: 4rem auto;\n    padding: 0 1rem;\n  }\n  .safety__button {\n    display: flex;\n    flex-direction: row;\n    justify-content: center;\n    align-items: center;\n    height: 100%;\n    width: 100%;\n    max-width: 20rem;\n    margin: 2rem auto;\n    border-radius: 0.33rem;\n    background-color: #00824a;\n    border: 0 solid;\n    box-shadow: inset 0 0 20px rgba(255, 255, 255, 0);\n    outline: 1px solid;\n    outline-color: rgba(58, 58, 58, 0.5);\n    outline-offset: 0px;\n    text-shadow: none;\n    transition: all 1250ms cubic-bezier(0.19, 1, 0.22, 1);\n  }\n  .safety__button:hover {\n    box-shadow: inset 0 0 20px rgba(255, 255, 255, 0.5),\n      0 0 20px rgba(75, 180, 65, 0.2);\n    outline-color: rgba(255, 255, 255, 0);\n    outline-offset: 15px;\n    text-shadow: 1px 1px 2px rgba(11, 133, 38, 0.2);\n    transition: all 1250ms cubic-bezier(0.19, 1, 0.22, 1);\n  }\n  .button__square {\n    background-color: #fafafa;\n    margin: 0.5rem;\n    padding: 0.5rem;\n    border-radius: 0.33rem;\n    display: flex;\n    justify-content: center;\n    align-items: center;\n  }\n  .button__circle {\n    height: 2rem;\n    width: 2rem;\n    aspect-ratio: 1 \/ 1;\n    background-color: #00824a;\n    border-radius: 50%;\n  }\n  .button__text {\n    display: flex;\n    width: 100%;\n    justify-content: center;\n    align-content: center;\n  }\n  .button__text p {\n    margin: 0;\n    padding: 0;\n    color: #fafafa;\n    text-decoration: none;\n    font-size: 1.66rem;\n    font-weight: 700;\n    text-align: center;\n    line-height: 0;\n  }\n  a {\n    text-decoration: none;\n  }\n  .image__container--404 {\n    width: 100%;\n    max-width: 700px;\n    margin: 4rem auto;\n  }\n  .image__container--404 img {\n    width: 100%;\n    height: auto;\n    display: block;\n  }\n\n  \/* Mobile responsiveness *\/\n  @media screen and (max-width: 768px) {\n    .section__container {\n      margin: 2rem auto;\n    }\n    \n    .image__container--404 {\n      margin: 2rem auto;\n    }\n    \n    .safety__button {\n      width: 100%;\n      max-width: 18rem;\n      margin: 1.5rem auto;\n    }\n    \n    .button__text p {\n      font-size: 1.4rem;\n    }\n  }\n\n  @media screen and (max-width: 480px) {\n    .section__container {\n      margin: 1rem auto;\n      padding: 0 0.5rem;\n    }\n    \n    .image__container--404 {\n      margin: 1.5rem auto;\n    }\n    \n    .safety__button {\n      max-width: 16rem;\n      margin: 1rem auto;\n    }\n    \n    .button__square {\n      margin: 0.4rem;\n      padding: 0.4rem;\n    }\n    \n    .button__circle {\n      height: 1.5rem;\n      width: 1.5rem;\n    }\n    \n    .button__text p {\n      font-size: 1.2rem;\n    }\n  }\n<\/style>","width":"wrapper","color_scheme":"","padding_top":0,"padding_bottom":0}},"main":{"type":"section-404","settings":{"color_scheme":""}}},"order":["section_custom_code_hJiP3w","main"]}