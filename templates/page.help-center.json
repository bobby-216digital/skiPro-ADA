 look up or change online orders.<\/em><\/p>","text_font_size":"body-medium","position":"left","padding_bottom":16}},"buttons_W6gGaW":{"type":"buttons","settings":{"position":"left","button_text":"Store Details","button_url":"shopify:\/\/pages\/locations","button_type":"btn--primary","button_size":"","button_style":"btn--solid","show_arrow":false,"button_secondary_text":"","button_secondary_url":"","button_secondary_type":"btn--primary","button_secondary_size":"","button_secondary_style":"btn--outline","show_secondary_arrow":false,"padding_bottom":16}},"heading_4JTP7f":{"type":"heading","settings":{"title":"Phoenix Metro Area","heading_font_size":"heading-large","position":"right","padding_bottom":16,"heading_tag":"automatic"}},"text_EWzagD":{"type":"text","settings":{"text":"{{ metaobjects.location.mesa.hours | metafield_tag }}<p><em>Hours of <\/em>operations <em>are subject to change<\/em><\/p>","text_font_size":"body-medium","position":"right","padding_bottom":16}},"heading_eLneQC":{"type":"heading","settings":{"title":"Phoenix & Avalanche Outlet","heading_font_size":"heading-small","position":"right","padding_bottom":16,"heading_tag":"automatic"}},"text_B9mCkX":{"type":"text","settings":{"text":"<p><strong>Address:<\/strong> 2110 East Camelback Road, Phoenix, Arizona 85016<\/p><p><strong>Direct Phone:<\/strong> <a href=\"tel:6029553939\" title=\"tel:6029553939\">602-955-3939<\/a><\/p>","text_font_size":"body-medium","position":"right","padding_bottom":16}},"heading_nM6dgW":{"type":"heading","settings":{"title":"Mesa","heading_font_size":"heading-small","position":"right","padding_bottom":16,"heading_tag":"automatic"}},"text_8D6DDw":{"type":"text","settings":{"text":"<p><strong>Address:<\/strong> 1924 West Rio Salado Parkway, Mesa, Arizona, 85201<\/p><p><strong>Direct Phone:<\/strong> <a href=\"tel:4809626910\" title=\"tel:4809626910\">480-962-6910<\/a><\/p>","text_font_size":"body-medium","position":"right","padding_bottom":16}},"heading_QXhNzp":{"type":"heading","settings":{"title":"Desert Ridge","heading_font_size":"heading-small","position":"right","padding_bottom":16,"heading_tag":"automatic"}},"text_bfq6Az":{"type":"text","settings":{"text":"<p><strong>Address:<\/strong> 21001 North Taum Boulevard, Phoenix, Arizona, 85050<\/p><p><strong>Direct Phone:<\/strong> <a href=\"tel:480-443-5670\" title=\"tel:480-443-5670\">480-443-5670<\/a><\/p>","text_font_size":"body-medium","position":"right","padding_bottom":16}},"heading_aLgjC4":{"type":"heading","settings":{"title":"Reno-Tahoe Area","heading_font_size":"heading-large","position":"right","padding_bottom":16,"heading_tag":"automatic"}},"text_tmdawt":{"type":"text","settings":{"text":"{{ metaobjects.location.reno.hours | metafield_tag }}","text_font_size":"body-medium","position":"right","padding_bottom":16}},"heading_zGReVH":{"type":"heading","settings":{"title":"Reno Store","heading_font_size":"heading-small","position":"right","padding_bottom":16,"heading_tag":"automatic"}},"text_wLtcXp":{"type":"text","settings":{"text":"<p><strong>Address:<\/strong> 6407 South Virginia Street, Suite 110, Reno, Nevada 89511<\/p><p><strong>Direct Phone:<\/strong> <a href=\"tel:775-420-3427\" title=\"tel:7754203427\">775-420-3427<\/a><\/p>","text_font_size":"body-medium","position":"right","padding_bottom":16}}},"block_order":["heading_jHqQQA","text_yCxWwJ","buttons_W6gGaW","heading_4JTP7f","text_EWzagD","heading_eLneQC","text_B9mCkX","heading_nM6dgW","text_8D6DDw","heading_QXhNzp","text_bfq6Az","heading_aLgjC4","text_tmdawt","heading_zGReVH","text_wLtcXp"],"name":"Rich text columns","settings":{"left_column_width":40,"divider_width":20,"show_line":true,"right_column_width":40,"align_text":"text-left","width":"wrapper--full-padded","align_text_mobile":"text-left--mobile","color_scheme":"","padding_top":100,"padding_bottom":100}},"section_accordion_group_9ktXVV":{"type":"section-accordion-group","blocks":{"heading_kM9aH9":{"type":"heading","settings":{"title":"Online Orders"}},"question_TryiKd":{"type":"question","settings":{"default_open":false,"title":"How Do I Track My Order","content":"<p>Use Order Lookup in your account. If you checked out as a guest, use the link in your confirmation email. Need help? Open chat and share your order number.<\/p>","show_icon":false,"icon_name":"icon-award","icon_size":20,"icon_color":""}},"question_kWzxJk":{"type":"question","settings":{"default_open":false,"title":"Can I change or cancel my order after placing it?","content":"<p>We can try to help before the order ships. Open chat or email support with your order number and the change you need. Once shipped, we can assist with an exchange or return.<\/p>","show_icon":false,"icon_name":"icon-award","icon_size":20,"icon_color":""}},"question_NNmMtU":{"type":"question","settings":{"default_open":false,"title":"I entered the wrong address. What can I do?","content":"<p>Contact us ASAP with your order number and the correct address. If the order has not shipped, we’ll update it. If it’s in transit, we’ll explore carrier options.<\/p>","show_icon":false,"icon_name":"icon-award","icon_size":20,"icon_color":""}}},"block_order":["heading_kM9aH9","question_TryiKd","question_kWzxJk","question_NNmMtU"],"name":"Accordion group","settings":{"heading_font_size":"heading-large","question_font_size":"heading-x-small","width":"wrapper","columns":"1","color_scheme":"","padding_top":50,"padding_bottom":50}},"section_accordion_group_xh34XV":{"type":"section-accordion-group","blocks":{"heading_G8CYnx":{"type":"heading","settings":{"title":"Shipping and delivery"}},"question_ieCHbQ":{"type":"question","settings":{"default_open":false,"title":"When will my order ship?","content":"<p>Most in‑stock items ship within 1-3 business days. You’ll get a shipping confirmation email with tracking as soon as it leaves our fulfillment location. In rare occasions, it may take up to a week to receive tracking information. We will reach out if we experience any issues fulfilling your order.<\/p>","show_icon":false,"icon_name":"icon-award","icon_size":20,"icon_color":""}},"question_EUDbVw":{"type":"question","settings":{"default_open":false,"title":"Do you offer expedited shipping?","content":"<p>Yes. Expedited options are shown at checkout. Weather and carrier delays may impact delivery times during peak season. <em><strong>Please note:<\/strong><\/em><em> Expedited shipping does not include lead times.<\/em><\/p>","show_icon":false,"icon_name":"icon-award","icon_size":20,"icon_color":""}},"question_JDAKaG":{"type":"question","settings":{"default_open":false,"title":"Do you ship to PO boxes or internationally?","content":"<p><strong>PO BOXES: <\/strong>Please be sure that the shipping address is to a PO Box. Please keep in mind that the post office often cannot accept oversized packages (Skis, Boards, Surfs, Etc.). We will contact you if we have issues shipping your order. <br\/><strong>INTERNATIONAL SHIPPING:<\/strong> Ski Pro DOES NOT ship to international addresses. Any order with an international address will be cancelled. <\/p>","show_icon":false,"icon_name":"icon-award","icon_size":20,"icon_color":""}}},"block_order":["heading_G8CYnx","question_ieCHbQ","question_EUDbVw","question_JDAKaG"],"name":"Accordion group","settings":{"heading_font_size":"heading-large","question_font_size":"heading-x-small","width":"wrapper","columns":"1","color_scheme":"","padding_top":50,"padding_bottom":50}},"section_accordion_group_Wg4MjF":{"type":"section-accordion-group","blocks":{"heading_BAKGED":{"type":"heading","settings":{"title":"Returns and exchanges"}},"question_f3fTaA":{"type":"question","settings":{"default_open":false,"title":"What is your return window?","content":"<p>New, unused items can typically be returned within 30 days of delivery with original packaging and tags.<\/p>","show_icon":false,"icon_name":"icon-award","icon_size":20,"icon_color":""}},"question_UGGReN":{"type":"question","settings":{"default_open":false,"title":"How do I start an exchange?","content":"<p>Due to some technology limitations, we are unable to do 1 to 1 exchanges at this time. New orders must be placed for new products, and returns can be created for fulfilled orders. We can issue store credit or refunds back to the original payment method.<\/p>","show_icon":false,"icon_name":"icon-award","icon_size":20,"icon_color":""}},"question_6htA6R":{"type":"question","settings":{"default_open":false,"title":"Are there items that can’t be returned?","content":"<p>Mounted skis, used items, final sale, and safety gear like avalanche equipment may be excluded. Check the product page or ask us before purchasing.<\/p>","show_icon":false,"icon_name":"icon-award","icon_size":20,"icon_color":""}}},"block_order":["heading_BAKGED","question_f3fTaA","question_UGGReN","question_6htA6R"],"name":"Accordion group","settings":{"heading_font_size":"heading-large","question_font_size":"heading-x-small","width":"wrapper","columns":"1","color_scheme":"","padding_top":50,"padding_bottom":50}},"section_accordion_group_jpPiEa":{"type":"section-accordion-group","blocks":{"heading_qWy47X":{"type":"heading","settings":{"title":"In‑store support"}},"question_WbDRbi":{"type":"question","settings":{"default_open":false,"title":"What can store teams help with?","content":"<p>Anything you need! Ski Pro specializes in 1 on 1 customer service. Product selection, gear fitting and sizing, and questions about rentals and service. However, in‑store teams can’t access or manage online orders.<\/p>","show_icon":false,"icon_name":"icon-award","icon_size":20,"icon_color":""}},"question_QKTqQ8":{"type":"question","settings":{"default_open":false,"title":"Can a store process my online return?","content":"<p>Yes, our in-store locations can coordinate a return for online purchases. Please make sure to bring in a copy of your order confirmation or packing lists.<\/p>","show_icon":false,"icon_name":"icon-award","icon_size":20,"icon_color":""}}},"block_order":["heading_qWy47X","question_WbDRbi","question_QKTqQ8"],"name":"Accordion group","settings":{"heading_font_size":"heading-large","question_font_size":"heading-x-small","width":"wrapper","columns":"1","color_scheme":"","padding_top":50,"padding_bottom":50}},"section_accordion_group_yFPx7M":{"type":"section-accordion-group","blocks":{"heading_KzFLH4":{"type":"heading","settings":{"title":"Rentals and services"}},"question_z4pWVk":{"type":"question","settings":{"default_open":false,"title":"Do you rent skis and snowboards?","content":"<p>Yes. Reserve daily rentals online or call your preferred store for availability and sizing. Bring a valid ID and payment method at pickup. You must be 18 years or older to purchase rentals from Ski Pro.<\/p>","show_icon":false,"icon_name":"icon-award","icon_size":20,"icon_color":""}},"question_Aew6JF":{"type":"question","settings":{"default_open":false,"title":"Do you offer tuning and repairs?","content":"<p>Yes. Base grinds, edge sharpening, wax, mounts, and more. Turnaround varies by season; ask your local store for current timing.<\/p>","show_icon":false,"icon_name":"icon-award","icon_size":20,"icon_color":""}}},"block_order":["heading_KzFLH4","question_z4pWVk","question_Aew6JF"],"name":"Accordion group","settings":{"heading_font_size":"heading-large","question_font_size":"heading-x-small","width":"wrapper","columns":"1","color_scheme":"","padding_top":50,"padding_bottom":50}},"section_accordion_group_xxKUW7":{"type":"section-accordion-group","blocks":{"heading_k4exWd":{"type":"heading","settings":{"title":"Warranty and product issues"}},"question_JMe9gC":{"type":"question","settings":{"default_open":false,"title":"How do I submit a warranty claim?","content":"<p>Email support with photos, your order number, and a brief description of the issue. We’ll coordinate with the brand and outline next steps.<\/p>","show_icon":false,"icon_name":"icon-award","icon_size":20,"icon_color":""}},"question_a9cWmC":{"type":"question","settings":{"default_open":false,"title":"My item arrived damaged. What should I do?","content":"<p>Save the packaging, take photos of the box and item, and contact us right away so we can arrange a replacement or refund.<\/p>","show_icon":false,"icon_name":"icon-award","icon_size":20,"icon_color":""}}},"block_order":["heading_k4exWd","question_JMe9gC","question_a9cWmC"],"name":"Accordion group","settings":{"heading_font_size":"heading-large","question_font_size":"heading-x-small","width":"wrapper","columns":"1","color_scheme":"","padding_top":50,"padding_bottom":50}},"section_accordion_group_6dytBi":{"type":"section-accordion-group","blocks":{"heading_YKEJrd":{"type":"heading","settings":{"title":"Payments, gift cards, and pricing"}},"question_jKjNTq":{"type":"question","settings":{"default_open":false,"title":"Can I purchase gift cards?","content":"<p>Yes. Sue to technology limitations, ski pro offers two types of gift cards. <\/p>","show_icon":false,"icon_name":"icon-award","icon_size":20,"icon_color":""}},"question_QT9wCG":{"type":"question","settings":{"default_open":false,"title":"What payment methods do you accept?","content":"<p>Major credit cards, select digital wallets, and gift cards where available. Exact options show at checkout.<\/p>","show_icon":false,"icon_name":"icon-award","icon_size":20,"icon_color":""}},"question_4MXFkG":{"type":"question","settings":{"default_open":false,"title":"Do you price match?","content":"<p>We aim to offer competitive pricing. If you find a lower advertised price from an authorized retailer, contact us with a link and we’ll review.<\/p>","show_icon":false,"icon_name":"icon-award","icon_size":20,"icon_color":""}}},"block_order":["heading_YKEJrd","question_jKjNTq","question_QT9wCG","question_4MXFkG"],"name":"Accordion group","settings":{"heading_font_size":"heading-large","question_font_size":"heading-x-small","width":"wrapper","columns":"1","color_scheme":"","padding_top":50,"padding_bottom":50}},"section_accordion_group_zFQeYU":{"type":"section-accordion-group","blocks":{"headin