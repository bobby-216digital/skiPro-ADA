{% doc %}
  @prompt
    Create a full width hero slideshow section with the following features: multiple slides with autoplay and navigation controls, each slide has two image fields (one for desktop and one for mobile), desktop images scale responsively to fit different screen widths while maintaining aspect ratio, mobile images automatically display on phone screens, text overlay options with heading and button for each slide, and smooth transitions between slides, I need the images to be a slideshow and swipe through the images, not fade from one to the next, I need the images to resize with the desktop page size for different screens
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-hero-slideshow-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    overflow: hidden;
    display: block;
  }

  .ai-hero-slideshow-container-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: 0;
    padding-bottom: {{ block.settings.aspect_ratio_desktop }}%;
    overflow: hidden;
  }

  .ai-hero-slideshow-slides-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    display: flex;
    width: 100%;
    height: 100%;
    transition: transform {{ block.settings.transition_speed }}ms ease-in-out;
    will-change: transform;
  }

  .ai-hero-slide-{{ ai_gen_id }} {
    position: relative;
    min-width: 100%;
    width: 100%;
    height: 100%;
    flex-shrink: 0;
  }

  .ai-hero-slide-image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .ai-hero-slide-mobile-image-{{ ai_gen_id }} {
    display: none;
  }

  .ai-hero-slide-overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: {{ block.settings.overlay_color }};
    opacity: {{ block.settings.overlay_opacity }};
  }

  .ai-hero-slide-content-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    text-align: center;
    color: {{ block.settings.text_color }};
    z-index: 2;
    width: 90%;
    max-width: {{ block.settings.content_max_width }}px;
  }

  .ai-hero-slide-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    font-weight: 700;
    margin: 0 0 16px;
    line-height: 1.2;
  }

  .ai-hero-slide-button-{{ ai_gen_id }} {
    display: inline-block;
    padding: 14px 32px;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    font-size: {{ block.settings.button_font_size }}px;
    font-weight: 600;
    transition: all 0.3s ease;
  }

  .ai-hero-slide-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_bg_color }};
    color: {{ block.settings.button_hover_text_color }};
    transform: translateY(-2px);
  }

  .ai-hero-nav-arrows-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 3;
    background-color: {{ block.settings.arrow_bg_color }};
    border: none;
    width: {{ block.settings.arrow_size }}px;
    height: {{ block.settings.arrow_size }}px;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
    opacity: {{ block.settings.arrow_opacity }};
  }

  .ai-hero-nav-arrows-{{ ai_gen_id }}:hover {
    opacity: 1;
    transform: translateY(-50%) scale(1.1);
  }

  .ai-hero-nav-arrows-{{ ai_gen_id }}.prev {
    left: 20px;
  }

  .ai-hero-nav-arrows-{{ ai_gen_id }}.next {
    right: 20px;
  }

  .ai-hero-nav-arrows-{{ ai_gen_id }} svg {
    width: 24px;
    height: 24px;
    stroke: {{ block.settings.arrow_color }};
  }

  .ai-hero-nav-dots-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 10px;
    z-index: 3;
  }

  .ai-hero-nav-dot-{{ ai_gen_id }} {
    width: {{ block.settings.dot_size }}px;
    height: {{ block.settings.dot_size }}px;
    border-radius: 50%;
    background-color: {{ block.settings.dot_color }};
    border: none;
    cursor: pointer;
    transition: all 0.3s ease;
    opacity: {{ block.settings.dot_inactive_opacity }};
  }

  .ai-hero-nav-dot-{{ ai_gen_id }}.active {
    opacity: 1;
    transform: scale(1.2);
  }

  .ai-hero-nav-dot-{{ ai_gen_id }}:hover {
    opacity: 1;
  }

  @media screen and (max-width: 749px) {
    .ai-hero-slideshow-container-{{ ai_gen_id }} {
      padding-bottom: {{ block.settings.aspect_ratio_mobile }}%;
    }

    .ai-hero-slide-desktop-image-{{ ai_gen_id }} {
      display: none;
    }

    .ai-hero-slide-mobile-image-{{ ai_gen_id }} {
      display: block;
    }

    .ai-hero-slide-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size_mobile }}px;
    }

    .ai-hero-slide-button-{{ ai_gen_id }} {
      padding: 12px 24px;
      font-size: {{ block.settings.button_font_size_mobile }}px;
    }

    .ai-hero-nav-arrows-{{ ai_gen_id }}.prev {
      left: 10px;
    }

    .ai-hero-nav-arrows-{{ ai_gen_id }}.next {
      right: 10px;
    }
  }
{% endstyle %}

<hero-slideshow-{{ ai_gen_id }}
  class="ai-hero-slideshow-{{ ai_gen_id }}"
  data-autoplay="{{ block.settings.autoplay }}"
  data-autoplay-speed="{{ block.settings.autoplay_speed }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-hero-slideshow-container-{{ ai_gen_id }}">
    <div class="ai-hero-slideshow-slides-{{ ai_gen_id }}">
      {% for i in (1..5) %}
        {% liquid
          assign slide_enabled_key = 'slide_' | append: i | append: '_enabled'
          assign desktop_image_key = 'slide_' | append: i | append: '_desktop_image'
          assign mobile_image_key = 'slide_' | append: i | append: '_mobile_image'
          assign heading_key = 'slide_' | append: i | append: '_heading'
          assign button_text_key = 'slide_' | append: i | append: '_button_text'
          assign button_link_key = 'slide_' | append: i | append: '_button_link'

          assign slide_enabled = block.settings[slide_enabled_key]
          assign desktop_image = block.settings[desktop_image_key]
          assign mobile_image = block.settings[mobile_image_key]
          assign heading = block.settings[heading_key]
          assign button_text = block.settings[button_text_key]
          assign button_link = block.settings[button_link_key]
        %}

        {% if slide_enabled %}
          <div class="ai-hero-slide-{{ ai_gen_id }}" data-slide="{{ i }}">
            {% if desktop_image %}
              <img
                src="{{ desktop_image | image_url: width: 2400 }}"
                srcset="{{ desktop_image | image_url: width: 800 }} 800w,
                        {{ desktop_image | image_url: width: 1200 }} 1200w,
                        {{ desktop_image | image_url: width: 1600 }} 1600w,
                        {{ desktop_image | image_url: width: 2000 }} 2000w,
                        {{ desktop_image | image_url: width: 2400 }} 2400w"
                sizes="100vw"
                alt="{{ desktop_image.alt | escape }}"
                class="ai-hero-slide-image-{{ ai_gen_id }} ai-hero-slide-desktop-image-{{ ai_gen_id }}"
                loading="{% if i == 1 %}eager{% else %}lazy{% endif %}"
              >
            {% endif %}

            {% if mobile_image %}
              <img
                src="{{ mobile_image | image_url: width: 800 }}"
                srcset="{{ mobile_image | image_url: width: 400 }} 400w,
                        {{ mobile_image | image_url: width: 600 }} 600w,
                        {{ mobile_image | image_url: width: 800 }} 800w,
                        {{ mobile_image | image_url: width: 1000 }} 1000w"
                sizes="100vw"
                alt="{{ mobile_image.alt | escape }}"
                class="ai-hero-slide-image-{{ ai_gen_id }} ai-hero-slide-mobile-image-{{ ai_gen_id }}"
                loading="{% if i == 1 %}eager{% else %}lazy{% endif %}"
              >
            {% elsif desktop_image %}
              <img
                src="{{ desktop_image | image_url: width: 800 }}"
                srcset="{{ desktop_image | image_url: width: 400 }} 400w,
                        {{ desktop_image | image_url: width: 600 }} 600w,
                        {{ desktop_image | image_url: width: 800 }} 800w,
                        {{ desktop_image | image_url: width: 1000 }} 1000w"
                sizes="100vw"
                alt="{{ desktop_image.alt | escape }}"
                class="ai-hero-slide-image-{{ ai_gen_id }} ai-hero-slide-mobile-image-{{ ai_gen_id }}"
                loading="{% if i == 1 %}eager{% else %}lazy{% endif %}"
              >
            {% endif %}

            {% if block.settings.show_overlay %}
              <div class="ai-hero-slide-overlay-{{ ai_gen_id }}"></div>
            {% endif %}

            {% if heading != blank or button_text != blank %}
              <div class="ai-hero-slide-content-{{ ai_gen_id }}">
                {% if heading != blank %}
                  <h2 class="ai-hero-slide-heading-{{ ai_gen_id }}">{{ heading }}</h2>
                {% endif %}

                {% if button_text != blank and button_link != blank %}
                  <a href="{{ button_link }}" class="ai-hero-slide-button-{{ ai_gen_id }}">
                    {{ button_text }}
                  </a>
                {% endif %}
              </div>
            {% endif %}
          </div>
        {% endif %}
      {% endfor %}
    </div>

    {% if block.settings.show_arrows %}
      <button
        class="ai-hero-nav-arrows-{{ ai_gen_id }} prev"
        aria-label="Previous slide"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>

      <button
        class="ai-hero-nav-arrows-{{ ai_gen_id }} next"
        aria-label="Next slide"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>
    {% endif %}

    {% if block.settings.show_dots %}
      <div class="ai-hero-nav-dots-{{ ai_gen_id }}"></div>
    {% endif %}
  </div>
</hero-slideshow-{{ ai_gen_id }}>

<script>
  (function() {
    class HeroSlideshow{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentSlide = 0;
        this.autoplayTimer = null;
        this.touchStartX = 0;
        this.touchEndX = 0;
      }

      connectedCallback() {
        this.slidesContainer = this.querySelector('.ai-hero-slideshow-slides-{{ ai_gen_id }}');
        this.slides = Array.from(this.querySelectorAll('.ai-hero-slide-{{ ai_gen_id }}'));
        this.prevButton = this.querySelector('.ai-hero-nav-arrows-{{ ai_gen_id }}.prev');
        this.nextButton = this.querySelector('.ai-hero-nav-arrows-{{ ai_gen_id }}.next');
        this.dotsContainer = this.querySelector('.ai-hero-nav-dots-{{ ai_gen_id }}');
        this.autoplay = this.dataset.autoplay === 'true';
        this.autoplaySpeed = parseInt(this.dataset.autoplaySpeed) || 5000;

        if (this.slides.length === 0) return;

        this.init();
      }

      init() {
        this.createDots();
        this.showSlide(0);
        this.setupEventListeners();

        if (this.autoplay) {
          this.startAutoplay();
        }
      }

      createDots() {
        if (!this.dotsContainer) return;

        this.slides.forEach((slide, index) => {
          const dot = document.createElement('button');
          dot.classList.add('ai-hero-nav-dot-{{ ai_gen_id }}');
          dot.setAttribute('aria-label', 'Go to slide ' + (index + 1));
          dot.addEventListener('click', () => {
            this.goToSlide(index);
            this.resetAutoplay();
          });
          this.dotsContainer.appendChild(dot);
        });

        this.dots = Array.from(this.dotsContainer.querySelectorAll('.ai-hero-nav-dot-{{ ai_gen_id }}'));
      }

      setupEventListeners() {
        if (this.prevButton) {
          this.prevButton.addEventListener('click', () => {
            this.previousSlide();
            this.resetAutoplay();
          });
        }

        if (this.nextButton) {
          this.nextButton.addEventListener('click', () => {
            this.nextSlide();
            this.resetAutoplay();
          });
        }

        this.slidesContainer.addEventListener('touchstart', (e) => {
          this.touchStartX = e.changedTouches[0].screenX;
        });

        this.slidesContainer.addEventListener('touchend', (e) => {
          this.touchEndX = e.changedTouches[0].screenX;
          this.handleSwipe();
        });

        this.addEventListener('mouseenter', () => {
          if (this.autoplay) {
            this.stopAutoplay();
          }
        });

        this.addEventListener('mouseleave', () => {
          if (this.autoplay) {
            this.startAutoplay();
          }
        });
      }

      handleSwipe() {
        const swipeThreshold = 50;
        const diff = this.touchStartX - this.touchEndX;

        if (Math.abs(diff) > swipeThreshold) {
          if (diff > 0) {
            this.nextSlide();
          } else {
            this.previousSlide();
          }
          this.resetAutoplay();
        }
      }

      showSlide(index) {
        const offset = -index * 100;
        this.slidesContainer.style.transform = 'translateX(' + offset + '%)';

        if (this.dots) {
          this.dots.forEach((dot, i) => {
            if (i === index) {
              dot.classList.add('active');
            } else {
              dot.classList.remove('active');
            }
          });
        }

        this.currentSlide = index;
      }

      goToSlide(index) {
        this.showSlide(index);
      }

      nextSlide() {
        const nextIndex = (this.currentSlide + 1) % this.slides.length;
        this.showSlide(nextIndex);
      }

      previousSlide() {
        const prevIndex = (this.currentSlide - 1 + this.slides.length) % this.slides.length;
        this.showSlide(prevIndex);
      }

      startAutoplay() {
        this.autoplayTimer = setInterval(() => {
          this.nextSlide();
        }, this.autoplaySpeed);
      }

      stopAutoplay() {
        if (this.autoplayTimer) {
          clearInterval(this.autoplayTimer);
          this.autoplayTimer = null;
        }
      }

      resetAutoplay() {
        if (this.autoplay) {
          this.stopAutoplay();
          this.startAutoplay();
        }
      }

      disconnectedCallback() {
        this.stopAutoplay();
      }
    }

    customElements.define('hero-slideshow-{{ ai_gen_id }}', HeroSlideshow{{ ai_gen_id }});
  })();
</script>

